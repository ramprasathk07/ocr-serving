# Copy to .env and adjust. Everything is read by common/config.py (prefix OCR_).
# Defaults in that file are the source of truth; this lists what you will actually change.

# ---------------------------------------------------------------------- service
OCR_ENV=dev                       # dev | staging | prod
OCR_LOG_LEVEL=INFO
OCR_LOG_FORMAT=json               # json for shipping, text for a readable console

# ----------------------------------------------------------------------- model
# Served by every stack. Alternatives:
#   tencent/HunyuanOCR
#   Qwen/Qwen2.5-VL-3B-Instruct-AWQ   (fallback, guaranteed vLLM multimodal path)
OCR_MODEL_ID=PaddlePaddle/PaddleOCR-VL

# Whichever serving stack is currently active (OpenAI-compatible base URL):
#   vLLM standalone : http://localhost:8001/v1
#   Ray Serve       : http://localhost:8000/v1
#   Triton (vLLM)   : http://localhost:8000/v1
#   KServe          : http://<isvc-url>/openai/v1
#   CPU mock        : http://localhost:8001/v1   (make mock — no GPU required)
OCR_ENGINE_BASE_URL=http://localhost:8001/v1
OCR_ENGINE_API_KEY=EMPTY
OCR_ENGINE_TIMEOUT_S=300
OCR_ENGINE_MAX_RETRIES=2
OCR_ENGINE_MAX_TOKENS=512
OCR_ENGINE_MAX_CONCURRENCY=16     # client-side admission control into the engine

# ------------------------------------------------------------------ datastores
OCR_REDIS_URL=redis://localhost:6379/0
OCR_POSTGRES_DSN=postgresql://ocr:ocr@localhost:5432/ocr
OCR_POSTGRES_ENABLED=true         # false -> filesystem-only, service still runs
OCR_STORAGE_DIR=./storage         # local stand-in for object storage

# --------------------------------------------------------------------- gateway
# Comma-separated. "key" or "key:tenant" — the tenant scopes jobs and quotas.
OCR_API_KEYS=dev-key:demo
OCR_MAX_UPLOAD_MB=64
OCR_CORS_ORIGINS=*
OCR_RATE_LIMIT_RPS=5              # per API key, token bucket
OCR_RATE_LIMIT_BURST=20
OCR_QUOTA_PAGES_PER_DAY=5000      # per tenant; 0 disables

# ----------------------------------------------------------------------- queue
OCR_VISIBILITY_TIMEOUT_S=300      # a job idle this long is reclaimed by another worker
OCR_MAX_ATTEMPTS=3                # then the job goes to ocr:jobs:dead

# ---------------------------------------------------------------------- worker
OCR_WORKER_CONCURRENCY=2          # jobs in parallel per worker process
OCR_PAGE_CONCURRENCY=2            # pages in parallel per job
OCR_REGION_CONCURRENCY=2          # layout regions in parallel per page
OCR_WORKER_METRICS_PORT=9101

# ---------------------------------------------------------------- page pipeline
OCR_RENDER_DPI=150
OCR_ADAPTIVE_DPI=true             # match render DPI to the embedded scan resolution
OCR_MIN_DPI=110
OCR_MAX_DPI=250
OCR_MAX_PAGES=200
OCR_NATIVE_TEXT_EXTRACTION=true   # PDF pages with a text layer skip the GPU entirely
OCR_NATIVE_TEXT_MIN_CHARS=200
OCR_DEDUPLICATE_PAGES=true
OCR_DESKEW=true
OCR_DENOISE=false                 # expensive; only worth it on noisy scans
OCR_CLAHE=true

# ---------------------------------------------------------------------- layout
OCR_LAYOUT_ENABLED=true
OCR_LAYOUT_MODEL_PATH=models/doclayout_yolo.onnx   # absent -> whole-page regions
OCR_TILE_MAX_HEIGHT=1600
OCR_TILE_OVERLAP=64

# ------------------------------------------------------------------- artifacts
OCR_SEARCHABLE_PDF=true
OCR_RESULT_TTL_DAYS=7             # Redis job state TTL; PostgreSQL keeps the record
