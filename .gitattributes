# Normalise to LF in the repository; check out LF everywhere so the shell scripts
# and Dockerfiles stay runnable on Linux and inside WSL2 regardless of host OS.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.drawio    text eol=lf
*.mmd       text eol=lf

*.png       binary
*.jpg       binary
*.pdf       binary
*.onnx      binary
