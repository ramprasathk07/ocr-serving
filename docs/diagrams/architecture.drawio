        <mxCell id="bypass" value="GPU bypass — zero engine tokens" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;dashed=1;dashPattern=6 4;fillColor=#F3FAF4;strokeColor=#7FB58C;fontSize=11;fontColor=#3F8F55;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="96" y="300" width="250" height="290" as="geometry"/></mxCell>

        <mxCell id="n_start" value="Job reserved" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#EAF1FE;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="n_open" value="Open document — metadata, corrupt / encrypted guard" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BCAFD4;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="190" width="300" height="44" as="geometry"/></mxCell>

        <mxCell id="d_native" value="page has a text layer?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFDF5;strokeColor=#D9B65B;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="300" height="68" as="geometry"/></mxCell>
        <mxCell id="s_native" value="Extract native text" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7FB58C;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="121" y="334" width="200" height="42" as="geometry"/></mxCell>

        <mxCell id="n_render" value="Render page — adaptive DPI 110–250" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BCAFD4;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="404" width="300" height="44" as="geometry"/></mxCell>

        <mxCell id="d_skip" value="blank page or duplicate hash?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFDF5;strokeColor=#D9B65B;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="480" width="300" height="68" as="geometry"/></mxCell>
        <mxCell id="s_skip" value="Mark blank, or copy the original page's text" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7FB58C;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="121" y="486" width="200" height="56" as="geometry"/></mxCell>

        <mxCell id="n_pre" value="Preprocess — downscale · deskew · CLAHE" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BCAFD4;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="588" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="n_layout" value="Layout — regions · tiles · reading order" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BCAFD4;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="656" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="n_engine" value="Stream regions through the serving stack" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDF1EF;strokeColor=#C6685C;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="724" width="300" height="46" as="geometry"/></mxCell>
        <mxCell id="n_stitch" value="Stitch regions · normalise · repetition filter" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BCAFD4;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="794" width="300" height="44" as="geometry"/></mxCell>

        <mxCell id="n_merge" value="Merge pages — repair hyphenation across breaks" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BCAFD4;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="900" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="n_art" value="Write JSON · Markdown · searchable PDF" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BCAFD4;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="430" y="964" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="n_done" value="Persist · status = completed · XACK" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#EAF1FE;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="430" y="1028" width="300" height="42" as="geometry"/></mxCell>

        <mxCell id="ev" value="Event stream&#10;page_started · token · page_complete · progress" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDF4E7;strokeColor=#C98A2E;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="840" y="724" width="300" height="56" as="geometry"/></mxCell>

        <mxCell id="k1" value="A digitally generated PDF already contains its text. Reading it beats OCR on both speed and accuracy — the single largest throughput win on mixed corpora." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6875;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="k2" value="Perceptual hash over a 64×64 thumbnail. A duplicate waits for the original page's result and copies its text, so the document stays complete without a second engine call." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6875;" vertex="1" parent="1"><mxGeometry x="840" y="470" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="k3" value="Deskew before layout: a 3° tilt widens every box and merges adjacent columns." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6875;" vertex="1" parent="1"><mxGeometry x="840" y="588" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="k4" value="Bounded by an admission semaphore. Retries only before the first token — a resumed stream would duplicate text." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6875;" vertex="1" parent="1"><mxGeometry x="840" y="800" width="300" height="56" as="geometry"/></mxCell>
        <mxCell id="k5" value="A page whose engine call fails carries its own error; the rest of the document still completes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6875;" vertex="1" parent="1"><mxGeometry x="840" y="900" width="300" height="50" as="geometry"/></mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#5B6875;" edge="1" parent="1" source="n_start" target="n_open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#5B6875;" edge="1" parent="1" source="n_open" target="d_native"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#3F8F55;strokeWidth=2;fontColor=#3F8F55;" edge="1" parent="1" source="d_native" target="s_native"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#5B6875;fontColor=#5B6875;" edge="1" parent="1" source="d_native" target="n_render"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#5B6875;" edge="1" parent="1" source="n_render" target="d_skip"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#3F8F55;strokeWidth=2;fontColor=#3F8F55;" edge="1" parent="1" source="d_skip" target="s_skip"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#5B6875;fontColor=#5B6875;" edge="1" parent="1" source="d_skip" target="n_pre"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#5B6875;" edge="1" parent="1" source="n_pre" target="n_layout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#5B6875;" edge="1" parent="1" source="n_layout" target="n_engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#5B6875;" edge="1" parent="1" source="n_engine" target="n_stitch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="page text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#3F8F55;strokeWidth=2;fontColor=#3F8F55;" edge="1" parent="1" source="s_native" target="n_stitch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#3F8F55;strokeWidth=2;" edge="1" parent="1" source="s_skip" target="n_stitch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="next page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#BCAFD4;dashed=1;fontColor=#7A5EA8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_stitch" target="d_native"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="last page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#5B6875;fontColor=#5B6875;" edge="1" parent="1" source="n_stitch" target="n_merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#5B6875;" edge="1" parent="1" source="n_merge" target="n_art"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;strokeColor=#5B6875;" edge="1" parent="1" source="n_art" target="n_done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="token batches (~50 ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#C98A2E;fontColor=#A5741F;" edge="1" parent="1" source="n_engine" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="page_complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#C98A2E;dashed=1;fontColor=#A5741F;" edge="1" parent="1" source="n_stitch" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3-lifecycle" name="3 · Lifecycle &amp; failure paths">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t1" value="Job lifecycle and failure paths" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="60" y="28" width="700" height="28" as="geometry"/></mxCell>
        <mxCell id="t2" value="At-least-once delivery. A job is acknowledged only after its result is durable, so nothing is lost when a worker dies mid-document." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6875;" vertex="1" parent="1"><mxGeometry x="60" y="56" width="950" height="20" as="geometry"/></mxCell>
        <mxCell id="t3" value="page 3 of 3" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontColor=#8A94A6;" vertex="1" parent="1"><mxGeometry x="800" y="34" width="380" height="20" as="geometry"/></mxCell>
        <mxCell id="rule" value="" style="line;strokeWidth=1;html=1;strokeColor=#DDE2E8;" vertex="1" parent="1"><mxGeometry x="60" y="82" width="1120" height="8" as="geometry"/></mxCell>

        <mxCell id="s_new" value="" style="ellipse;html=1;fillColor=#3C4757;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="96" y="222" width="20" height="20" as="geometry"/></mxCell>
        <mxCell id="s_queued" value="queued" style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#F4F5F7;strokeColor=#8A94A6;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="170" y="200" width="150" height="64" as="geometry"/></mxCell>
        <mxCell id="s_proc" value="processing" style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#EAF1FE;strokeColor=#1F6FEB;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="470" y="200" width="170" height="64" as="geometry"/></mxCell>
        <mxCell id="s_done" value="completed" style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#EDF8F0;strokeColor=#3F8F55;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="850" y="130" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="s_failed" value="failed" style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#FDF1EF;strokeColor=#C6685C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="850" y="300" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="s_cancel" value="cancelled" style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#FBF6EC;strokeColor=#C98A2E;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="850" y="440" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="s_dlq" value="dead-letter&#10;ocr:jobs:dead" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C6685C;dashed=1;fontSize=11;fontColor=#2B3440;" vertex="1" parent="1"><mxGeometry x="490" y="420" width="150" height="56" as="geometry"/></mxCell>

        <mxCell id="pel" value="pending entries list — the job stays here, unacknowledged, for the whole run" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#8A94A6;" vertex="1" parent="1"><mxGeometry x="420" y="288" width="270" height="34" as="geometry"/></mxCell>

        <mxCell id="e1" value="POST /v1/ocr&#10;XADD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#3C4757;fontColor=#3C4757;" edge="1" parent="1" source="s_new" target="s_queued"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="reserve — XREADGROUP&#10;attempts += 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#1F6FEB;strokeWidth=2;fontColor=#1F6FEB;" edge="1" parent="1" source="s_queued" target="s_proc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="result durable → XACK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#3F8F55;strokeWidth=2;fontColor=#3F8F55;" edge="1" parent="1" source="s_proc" target="s_done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="permanent error&#10;corrupt · encrypted · missing blob" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#C6685C;strokeWidth=2;fontColor=#B0554A;" edge="1" parent="1" source="s_proc" target="s_failed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="DELETE /v1/ocr/{id}&#10;flag seen between pages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#C98A2E;fontColor=#A5741F;" edge="1" parent="1" source="s_proc" target="s_cancel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="transient error, or the worker dies&#10;→ entry left unacked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#8A94A6;dashed=1;fontColor=#5B6875;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_proc" target="s_queued"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="attempts ≥ max" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#C6685C;dashed=1;fontColor=#B0554A;" edge="1" parent="1" source="s_proc" target="s_dlq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;strokeColor=#C6685C;dashed=1;" edge="1" parent="1" source="s_dlq" target="s_failed"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="reclaim" value="XAUTOCLAIM — a peer takes over once the entry is idle past OCR_VISIBILITY_TIMEOUT_S.&#10;The owner refreshes that idle timer with XCLAIM while it is genuinely working, so a slow document is never mistaken for a dead worker." style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#F7F9FC;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;" vertex="1" parent="1"><mxGeometry x="96" y="330" width="330" height="70" as="geometry"/></mxCell>

        <mxCell id="tbl" value="Failure taxonomy" style="swimlane;startSize=32;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontStyle=1;fontSize=12;fontColor=#2B3440;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="96" y="560" width="1050" height="230" as="geometry"/></mxCell>
        <mxCell id="h1" value="what happened" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F5F7;strokeColor=#DDE2E8;fontSize=11;fontStyle=1;fontColor=#3C4757;" vertex="1" parent="tbl"><mxGeometry x="14" y="42" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="h2" value="classified as" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F5F7;strokeColor=#DDE2E8;fontSize=11;fontStyle=1;fontColor=#3C4757;" vertex="1" parent="tbl"><mxGeometry x="264" y="42" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="h3" value="what the system does" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F5F7;strokeColor=#DDE2E8;fontSize=11;fontStyle=1;fontColor=#3C4757;" vertex="1" parent="tbl"><mxGeometry x="414" y="42" width="350" height="30" as="geometry"/></mxCell>
        <mxCell id="h4" value="what the caller sees" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F4F5F7;strokeColor=#DDE2E8;fontSize=11;fontStyle=1;fontColor=#3C4757;" vertex="1" parent="tbl"><mxGeometry x="764" y="42" width="270" height="30" as="geometry"/></mxCell>

        <mxCell id="r1a" value="corrupt or encrypted document" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="14" y="72" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="r1b" value="permanent" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF1EF;strokeColor=#DDE2E8;fontSize=11;fontColor=#B0554A;" vertex="1" parent="tbl"><mxGeometry x="264" y="72" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="r1c" value="fails at once, entry acked — a retry cannot help" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="414" y="72" width="350" height="30" as="geometry"/></mxCell>
        <mxCell id="r1d" value="400 at submit, or job_failed" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="764" y="72" width="270" height="30" as="geometry"/></mxCell>

        <mxCell id="r2a" value="engine 5xx / timeout on one region" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="14" y="102" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="r2b" value="retryable" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FBF6EC;strokeColor=#DDE2E8;fontSize=11;fontColor=#A5741F;" vertex="1" parent="tbl"><mxGeometry x="264" y="102" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="r2c" value="jittered backoff, only before the first token" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="414" y="102" width="350" height="30" as="geometry"/></mxCell>
        <mxCell id="r2d" value="nothing — invisible if it recovers" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="764" y="102" width="270" height="30" as="geometry"/></mxCell>

        <mxCell id="r3a" value="region still failing after retries" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="14" y="132" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="r3b" value="partial" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FBF6EC;strokeColor=#DDE2E8;fontSize=11;fontColor=#A5741F;" vertex="1" parent="tbl"><mxGeometry x="264" y="132" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="r3c" value="page records its error, document completes" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="414" y="132" width="350" height="30" as="geometry"/></mxCell>
        <mxCell id="r3d" value="completed, with pages[i].error set" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="764" y="132" width="270" height="30" as="geometry"/></mxCell>

        <mxCell id="r4a" value="worker killed mid-document" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="14" y="162" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="r4b" value="redelivery" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EAF1FE;strokeColor=#DDE2E8;fontSize=11;fontColor=#1F6FEB;" vertex="1" parent="tbl"><mxGeometry x="264" y="162" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="r4c" value="a peer reclaims it after the visibility timeout" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="414" y="162" width="350" height="30" as="geometry"/></mxCell>
        <mxCell id="r4d" value="stream resumes; the job takes longer" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="764" y="162" width="270" height="30" as="geometry"/></mxCell>

        <mxCell id="r5a" value="same job failing repeatedly" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="14" y="192" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="r5b" value="poison" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FDF1EF;strokeColor=#DDE2E8;fontSize=11;fontColor=#B0554A;" vertex="1" parent="tbl"><mxGeometry x="264" y="192" width="150" height="30" as="geometry"/></mxCell>
        <mxCell id="r5c" value="dead-lettered with its reason; alert fires" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="414" y="192" width="350" height="30" as="geometry"/></mxCell>
        <mxCell id="r5d" value="job_failed with the error text" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontSize=11;fontColor=#3C4757;align=left;spacingLeft=8;" vertex="1" parent="tbl"><mxGeometry x="764" y="192" width="270" height="30" as="geometry"/></mxCell>

        <mxCell id="foot" value="Terminal states also expire the event stream (retained briefly so a late subscriber can still replay) and, for completed jobs, write the durable record to PostgreSQL. Redis job state carries a TTL of OCR_RESULT_TTL_DAYS; reads fall back to PostgreSQL after that." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5B6875;" vertex="1" parent="1"><mxGeometry x="96" y="806" width="1050" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
